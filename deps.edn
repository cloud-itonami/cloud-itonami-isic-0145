{:paths ["src"]
 ;; langgraph brings langchain transitively (both zero-/single-dep,
 ;; all .cljc -> portable to JVM / SCI / ClojureScript / GraalVM). It lives
 ;; in the kotoba-lang org of this workspace (transferred + renamed from
 ;; com-junkawasaki/langgraph-clj / com-junkawasaki/langchain-clj).
 ;;
 ;; This swine-farming vertical is SELF-CONTAINED: there is no
 ;; `kotoba-lang/swine-raising` to delegate facility-registration /
 ;; cost-threshold / closed-op-allowlist checks to, so those pure functions
 ;; live in `swineops.registry` / `swineops.facts` rather than wrapping
 ;; an external lib. This repo is standalone (forkable outside the
 ;; workspace); the :local/root paths only resolve inside the monorepo
 ;; checkout -- a standalone fork should override them with git
 ;; coordinates. For testing/CI without langgraph, use the core logic in
 ;; run-operation; production deployment requires the langgraph StateGraph
 ;; integration.
 :deps {}
 :aliases
 {;; offline workspace dev -- pin transitive langchain to local checkout
  :dev {:override-deps
        {io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}
        io.github.kotoba-lang/langgraph
        {:local/root "../../kotoba-lang/langgraph"}}}
  ;; clojure -M:dev:run  -> drive the demo through one OperationActor
  :run {:main-opts ["-m" "swineops.sim"]}
  ;; clojure -M:render-html [out-file] -> regenerate
  ;; docs/samples/operator-console.html by driving the REAL actor
  ;; (advisor -> governor -> phase gate) at build time. Throws rather
  ;; than writing a page whose claims the run did not produce.
  ;;
  ;; jp-go-dds lives in this alias rather than in :deps so that :run,
  ;; :test and :lint keep the actor's empty dependency set -- the actor
  ;; itself (operation/governor/store/facts/registry/phase/advisor) does
  ;; not depend on it; only the renderer's stylesheet does
  ;; (`jp-go-dds.skin/dds+skin`).
  :render-html {:extra-deps
                {io.github.kotoba-lang/jp-go-digital-design-system
                 {:git/url "https://github.com/kotoba-lang/jp-go-digital-design-system"
                  :git/sha "83db99546eabc53613ae826ea41d1533a3c574af"}}
                :main-opts ["-m" "swineops.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; static analysis -- clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
